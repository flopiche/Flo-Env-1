{
  "manifest_version": 3,
  "name": "Compteur Produits Vendeurs",
  "version": "1.0",
  "description": "Compte les produits par vendeur et suit l'évolution quotidienne",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://www.vertbaudet.fr/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.vertbaudet.fr/shop/marketplace/*"],
      "js": ["content.js"]
    }
  ]
}
