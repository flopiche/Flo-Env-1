{
  "manifest_version": 3,
  "name": "Compteur Produits Vendeurs",
  "version": "1.1",
  "description": "Compte les produits par vendeur et suit l'évolution quotidienne",
  "permissions": ["storage"],
  "host_permissions": ["https://www.vertbaudet.fr/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
