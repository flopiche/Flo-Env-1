{
  "manifest_version": 3,
  "name": "El Carlitator",
  "version": "1.2",
  "description": "Compte les produits par vendeur et suit l'évolution quotidienne",
  "permissions": ["storage", "downloads", "notifications", "alarms"],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": ["https://www.vertbaudet.fr/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
